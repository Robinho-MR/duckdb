# name: test/sql/parser/reject_accidental_type_syntax.test
# description: Type syntax the PEG grammar accepted by accident is rejected
# group: [parser]

# the precision of a TIMESTAMP WITH TIME ZONE is kept together with the time zone - it used to be dropped silently
query II
SELECT typeof('2020-01-01'::TIMESTAMP(3) WITH TIME ZONE), typeof('2020-01-01'::TIMESTAMP(9) WITH TIME ZONE);
----
TIMESTAMP WITH TIME ZONE	TIMESTAMP(9) WITH TIME ZONE

query III
SELECT typeof('2020-01-01'::TIMESTAMP(3)), typeof('2020-01-01'::TIMESTAMP(3) WITHOUT TIME ZONE),
       typeof('2020-01-01'::TIMESTAMP WITH TIME ZONE);
----
TIMESTAMP(3)	TIMESTAMP(3)	TIMESTAMP WITH TIME ZONE
