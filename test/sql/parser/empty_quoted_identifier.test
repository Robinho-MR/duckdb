# name: test/sql/parser/empty_quoted_identifier.test
# description: Empty quoted identifiers are regular (empty) column names
# group: [parser]

query I
SELECT 42 AS "";
----
42

query T
SELECT column_name FROM (DESCRIBE SELECT 42 AS "");
----
(empty)

query T
SELECT column_name FROM (DESCRIBE SELECT 42 AS ``);
----
(empty)

query I
SELECT "" FROM (SELECT 42 AS "");
----
42

query I
SELECT t."" FROM (SELECT 42 AS "") t;
----
42

query I
SELECT "" FROM (SELECT 42) t("");
----
42

query I
WITH x("") AS (SELECT 42) SELECT "" FROM x;
----
42

statement ok
CREATE TABLE t("" INTEGER, a INTEGER);

statement ok
INSERT INTO t VALUES (1, 2);

query II
SELECT "", a FROM t;
----
1	2

query T
SELECT name FROM pragma_table_info('t') ORDER BY cid;
----
(empty)
a

# an empty column name is still a name: duplicates are rejected
statement error
CREATE TABLE dup("" INTEGER, "" INTEGER);
----
<REGEX>:.*Column with name .* already exists.*

statement error
SELECT a."";
----
<REGEX>:.*Binder Error.*
