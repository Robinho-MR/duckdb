# name: test/sql/json/table/read_json_union.test
# description: Read json files with unions straight to columnar data
# group: [table]

require json

query I
SELECT data FROM read_ndjson('{DATA_DIR}/json/union.ndjson', columns={data: 'UNION(name VARCHAR, age INT, veteran BOOL)'})
----
Frank
5
false

# values that are not an object {"member": value} are read as the first member that accepts them
query II
SELECT data, union_tag(data) FROM read_ndjson('{DATA_DIR}/json/malformed/union/bad_key.ndjson', columns={data: 'UNION(name VARCHAR, age INT, veteran BOOL)'})
----
{"level":0}	name

query II
SELECT data, union_tag(data) FROM read_ndjson('{DATA_DIR}/json/malformed/union/empty_object.ndjson', columns={data: 'UNION(name VARCHAR, age INT, veteran BOOL)'})
----
{}	name

query II
SELECT data, union_tag(data) FROM read_ndjson('{DATA_DIR}/json/malformed/union/non_object.ndjson', columns={data: 'UNION(name VARCHAR, age INT, veteran BOOL)'})
----
0	age

query II
SELECT data, union_tag(data) FROM read_ndjson('{DATA_DIR}/json/malformed/union/too_many_keys.ndjson', columns={data: 'UNION(name VARCHAR, age INT, veteran BOOL)'})
----
{"id":1,"name":"O Brother, Where Art Thou?"}	name
