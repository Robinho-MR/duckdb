# name: test/sql/binder/empty_column_alias.test
# description: Empty column aliases in table and CTE alias lists are regular (empty) column names
# group: [binder]

query T
SELECT column_name FROM (DESCRIBE WITH x('') AS (SELECT 1) SELECT * FROM x);
----
(empty)

query I
WITH x('') AS (SELECT 42) SELECT "" FROM x;
----
42

query II
SELECT "", a FROM (SELECT 1, 2) t(a, '');
----
2	1

query I
WITH RECURSIVE r('') AS (SELECT 1 UNION ALL SELECT "" + 1 FROM r WHERE "" < 3) SELECT "" FROM r ORDER BY 1;
----
1
2
3

statement ok
CREATE TABLE tbl(i INT);

statement ok
INSERT INTO tbl VALUES (7);

query I
SELECT "" FROM tbl t('');
----
7

query T
SELECT column_name FROM (DESCRIBE SELECT * FROM range(3) t(''));
----
(empty)

query I
SELECT sum("") FROM range(3) t('');
----
3

# a string literal is not a column name in a CREATE VIEW alias list
statement error
CREATE VIEW v('') AS SELECT 1;
----
<REGEX>:Parser Error: syntax error.*

statement ok
CREATE VIEW v("") AS SELECT 1;

query I
SELECT "" FROM v;
----
1

query II
SELECT * FROM (SELECT 1, 2) t(a, "b c");
----
1	2

query I
WITH x(a) AS (SELECT 42) SELECT a FROM x;
----
42
