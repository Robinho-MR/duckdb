# name: test/sql/settings/credential_setting_redaction.test
# description: credential settings are redacted by current_setting and duckdb_settings
# group: [settings]

require noforcestorage

require skip_reload

statement ok
SET allow_unredacted_secrets = false;

statement ok
SET http_proxy_password='proxy_pw_leak';

statement ok
SET password='db_pw_leak';

query II
SELECT current_setting('http_proxy_password'), current_setting('password');
----
redacted	redacted

query II
SELECT name, value FROM duckdb_settings() WHERE name IN ('http_proxy_password', 'password') ORDER BY name;
----
http_proxy_password	redacted
password	redacted

statement ok
RESET http_proxy_password;

statement ok
RESET password;

# unset credentials are shown as they are
query II
SELECT current_setting('http_proxy_password'), current_setting('password');
----
(empty)	(empty)
