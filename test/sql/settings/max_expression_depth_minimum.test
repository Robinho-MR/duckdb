# name: test/sql/settings/max_expression_depth_minimum.test
# description: max_expression_depth cannot be set so low that statements stop working
# group: [settings]

statement error
SET max_expression_depth=0;
----
must be at least 10

statement error
SET max_expression_depth=6;
----
must be at least 10

statement ok
SELECT 42;

statement ok
SET max_expression_depth=10;

statement ok
SET max_expression_depth=1000;

query I
SELECT 42;
----
42
