# name: test/sql/cast/try_cast_union_impossible.test
# description: TRY_CAST into a UNION without a possible member mapping returns NULL
# group: [cast]

# casts between unions match the values against the member types, the member names don't matter
query I
SELECT TRY_CAST(u AS UNION(b INT)) FROM (SELECT union_value(a:=1) u);
----
1

query I
SELECT TRY_CAST(u AS UNION(b INT)) FROM (SELECT union_value(a:='x') u);
----
NULL

query I
SELECT TRY_CAST(1 AS UNION(b VARCHAR));
----
NULL

query I
SELECT TRY(CAST(union_value(a:='x') AS UNION(b INT)));
----
NULL

query I
SELECT TRY_CAST(NULL::INT AS UNION(b VARCHAR));
----
NULL

statement error
SELECT CAST(union_value(a:='x') AS UNION(b INT));
----
<REGEX>:Conversion Error.*does not match any of the member types.*

statement error
SELECT CAST(1 AS UNION(b VARCHAR));
----
<REGEX>:Conversion Error.*can't be implicitly cast to any of the union member types.*
