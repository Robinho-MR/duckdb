# name: test/sql/function/string/test_decode_encoding.test
# description: Test the encoding scalar functions
# group: [string]

query I
SELECT "decode_latin-1"('caf\xe9'::BLOB)
----
café

query I
SELECT "decode_utf-16"('a\x00\xe9\x00\x3d\xd8\x00\xde'::BLOB)
----
aé😀

query I
SELECT "decode_utf-16"(NULL::BLOB)
----
NULL

query I
SELECT "DECODE_LATIN-1"(''::BLOB)
----
(empty)

statement error
SELECT "decode_latin-1"('\x85'::BLOB)
----
File is not latin-1 encoded

statement error
SELECT "decode_utf-16"('a'::BLOB)
----
File is not utf-16 encoded

# streaming overload: an incomplete trailing character is not consumed
query I
SELECT "decode_utf-16"('a\x00\xe9'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

query I
SELECT "decode_utf-16"('a\x00\x3d\xd8'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

statement error
SELECT "decode_utf-16"('a\x00\xe9'::BLOB, true)
----
File is not utf-16 encoded

# the CSV reader finds encodings through the catalog
statement error
SELECT * FROM read_csv('data/csv/test/date.csv', encoding='no-such-encoding')
----
The CSV Reader does not support the encoding
