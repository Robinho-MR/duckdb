# name: test/sql/function/string/test_decode_encoding.test
# description: Test the encoding scalar functions
# group: [string]

query I
SELECT system.encodings."latin-1"('caf\xe9'::BLOB)
----
café

query I
SELECT system.encodings."utf-16"('a\x00\xe9\x00\x3d\xd8\x00\xde'::BLOB)
----
aé😀

query I
SELECT system.encodings."utf-16"(NULL::BLOB)
----
NULL

query I
SELECT SYSTEM.ENCODINGS."LATIN-1"(''::BLOB)
----
(empty)

statement error
SELECT system.encodings."latin-1"('\x85'::BLOB)
----
File is not latin-1 encoded

statement error
SELECT system.encodings."utf-16"('a'::BLOB)
----
File is not utf-16 encoded

# streaming overload: an incomplete trailing character is not consumed
query I
SELECT system.encodings."utf-16"('a\x00\xe9'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

query I
SELECT system.encodings."utf-16"('a\x00\x3d\xd8'::BLOB, false)
----
{'decoded': a, 'consumed': 2}

statement error
SELECT system.encodings."utf-16"('a\x00\xe9'::BLOB, true)
----
File is not utf-16 encoded

# the CSV reader finds encodings through the catalog
statement error
SELECT * FROM read_csv('data/csv/test/date.csv', encoding='no-such-encoding')
----
The CSV Reader does not support the encoding

# encodings live in their own schema, not in the search path
statement error
SELECT "latin-1"('a'::BLOB)
----
Catalog Error

query I
SELECT count(*) FROM duckdb_functions() WHERE schema_name = 'encodings' AND function_name = 'utf-16'
----
3

# encode and decode take the name of an encoding
query I
SELECT encode('café', 'latin-1')
----
caf\xE9

query I
SELECT decode('caf\xe9'::BLOB, 'latin-1')
----
café

query I
SELECT decode(encode('aé😀', 'utf-16'), 'UTF-16')
----
aé😀

query I
SELECT encode('aé', 'utf-16')
----
a\x00\xE9\x00

query I
SELECT decode('caf\xc3\xa9'::BLOB, 'utf-8')
----
café

query I
SELECT encode('café', 'utf-8')
----
caf\xC3\xA9

query I
SELECT encode(NULL, 'latin-1') IS NULL
----
true

query II
SELECT s, decode(encode(s, 'latin-1'), 'latin-1') = s FROM (VALUES ('abc'), ('ÿ'), ('')) t(s) ORDER BY s
----
(empty)	true
abc	true
ÿ	true

# the system.encodings functions are overloaded for both directions
query I
SELECT system.encodings."latin-1"('é')
----
\xE9

# the error options of decode still work
query I
SELECT decode('a\xff'::BLOB, 'replace')
----
a?

statement error
SELECT encode('€', 'latin-1')
----
Could not encode the character

statement error
SELECT decode('\x85'::BLOB, 'latin-1')
----
File is not latin-1 encoded

statement error
SELECT encode('a', 'no-such-encoding')
----
Unknown encoding "no-such-encoding"

statement error
SELECT decode('a'::BLOB, 'no-such-encoding')
----
Unknown encoding "no-such-encoding"
