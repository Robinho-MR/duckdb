# name: test/sql/table_function/duckdb_last_profile.test
# description: duckdb_last_profile() returns the profile of the previous query
# group: [table_function]

# the previous profile is state of the connection
require skip_reload

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM duckdb_last_profile());
----
profile	VARCHAR

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/duckdb_last_profile_output.json';

statement ok
SELECT count(*) FROM range(4242);

# the profiles are kept in tables, as the profile of a query that reads the previous profile is itself a profile
statement ok
CREATE TEMP TABLE first_read AS SELECT profile FROM duckdb_last_profile('json');

statement ok
CREATE TEMP TABLE second_read AS SELECT profile FROM duckdb_last_profile('json');

query II
SELECT profile LIKE '%UNGROUPED_AGGREGATE%', profile LIKE '%DUCKDB_LAST_PROFILE%' FROM first_read;
----
true	false

# reading the profile does not replace it: the second read sees the first reader, not the query before it
query II
SELECT profile LIKE '%UNGROUPED_AGGREGATE%', profile LIKE '%DUCKDB_LAST_PROFILE%' FROM second_read;
----
false	true

# other formats
statement ok
SELECT sum(i) FROM range(7373) t(i) GROUP BY i % 2;

statement ok
CREATE TEMP TABLE text_read AS SELECT profile FROM duckdb_last_profile('text');

statement ok
SELECT sum(i) FROM range(7373) t(i) GROUP BY i % 2;

statement ok
CREATE TEMP TABLE html_read AS SELECT profile FROM duckdb_last_profile('html');

query II
SELECT profile LIKE '%Perfect Hash Group By%', profile LIKE '%{%' FROM text_read;
----
true	false

query I
SELECT profile LIKE '%HASH_GROUP_BY%' FROM html_read;
----
true

# the default format is the configured one
query I
SELECT length(profile) > 0 FROM duckdb_last_profile();
----
true

statement error
SELECT * FROM duckdb_last_profile('no_such_format');
----
<REGEX>:.*no_such_format.*

statement error
SELECT * FROM duckdb_last_profile(NULL);
----
<REGEX>:.*cannot be NULL.*

# with profiling disabled there is no profile of the previous query
statement ok
RESET enable_profiling;

statement ok
SELECT sum(i) FROM range(7373) t(i) GROUP BY i % 2;

query I
SELECT profile LIKE '%HASH_GROUP_BY%' FROM duckdb_last_profile('json');
----
false
