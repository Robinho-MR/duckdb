# name: test/sql/transactions/commit_conflict_revert.test
# description: A commit that conflicts with an ALTER of another transaction is reverted completely
# group: [transactions]

require no_alternative_verify

require skip_reload

statement ok
CREATE TABLE t1(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE t2(id INTEGER);

statement ok
INSERT INTO t1 SELECT range FROM range(10);

statement ok
INSERT INTO t2 SELECT range FROM range(10);

statement ok con1
BEGIN

# the first undo entries modify t1, which is not altered
statement ok con1
DELETE FROM t1 WHERE id < 5

statement ok con1
UPDATE t2 SET id = id + 100

statement ok con2
BEGIN

statement ok con2
ALTER TABLE t2 ADD COLUMN j INTEGER

statement error con1
COMMIT
----
another transaction has altered this table

statement ok con2
COMMIT

# none of the changes of the conflicting transaction were committed
query I
SELECT count(*) FROM t1
----
10

query II
SELECT min(id), max(id) FROM t2
----
0	9

statement ok
DELETE FROM t1 WHERE id < 5

query I
SELECT count(*) FROM t1
----
5

# index entries of the reverted changes are restored
statement ok
CREATE TABLE t3(id INTEGER PRIMARY KEY);

statement ok
CREATE TABLE t4(id INTEGER);

statement ok
INSERT INTO t3 SELECT range FROM range(10);

statement ok con1
BEGIN

statement ok con1
DELETE FROM t3 WHERE id < 5

statement ok con1
INSERT INTO t3 VALUES (100)

statement ok con1
INSERT INTO t4 VALUES (1)

statement ok con2
BEGIN

statement ok con2
ALTER TABLE t4 ADD COLUMN j INTEGER

statement error con1
COMMIT
----
<REGEX>:.*altered.*

statement ok con2
COMMIT

statement error
INSERT INTO t3 VALUES (3)
----
Constraint Error

statement ok
INSERT INTO t3 VALUES (100)

query I
SELECT count(*) FROM t3
----
11

# conflict on a table with an index that is rebuilt by the other transaction
statement ok
CREATE TABLE t5(id INTEGER PRIMARY KEY, v INTEGER);

statement ok
CREATE TABLE t6(id INTEGER PRIMARY KEY);

statement ok
INSERT INTO t5 SELECT range, range FROM range(10);

statement ok
INSERT INTO t6 SELECT range FROM range(10);

statement ok con1
BEGIN

statement ok con1
DELETE FROM t6 WHERE id < 5

statement ok con1
DELETE FROM t5 WHERE id < 5

statement ok con1
INSERT INTO t5 VALUES (200, 200)

statement ok con2
BEGIN

statement ok con2
ALTER TABLE t5 ALTER v TYPE BIGINT

statement error con1
COMMIT
----
<REGEX>:.*altered.*

statement ok con2
COMMIT

query I
SELECT count(*) FROM t6
----
10

statement error
INSERT INTO t6 VALUES (3)
----
Constraint Error

query I
SELECT count(*) FROM t5
----
10

statement error
INSERT INTO t5 VALUES (3, 3)
----
Constraint Error
