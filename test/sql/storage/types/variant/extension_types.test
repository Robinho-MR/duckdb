# name: test/sql/storage/types/variant/extension_types.test
# group: [variant]

require inet

statement ok
CREATE TABLE tbl (col VARIANT)

statement ok
INSERT into tbl select '127.0.0.1'::INET

# the value is stored as its underlying STRUCT, together with the INET type
query I
select * from tbl
----
127.0.0.1

query I
select variant_typeof(col) from tbl
----
INET

query I
select COLUMNS(*)::INET from tbl
----
127.0.0.1

# casts use the casts of INET
query I
select col::VARCHAR from tbl
----
127.0.0.1

