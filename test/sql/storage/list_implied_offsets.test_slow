# name: test/sql/storage/list_implied_offsets.test_slow
# description: Test that the offsets of lists that are all non-NULL and have the same length are not stored
# group: [storage]

load {TEST_DIR}/list_implied_offsets.db readwrite v2.1.0

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET checkpoint_threshold='1TB';

statement ok
CREATE TABLE t AS SELECT i AS id, [i, i + 1, i + 2] AS l FROM range(300000) t(i);

statement ok
CHECKPOINT;

restart

# the list offsets have no segments
query I
SELECT COUNT(*) FROM pragma_storage_info('t') WHERE column_name = 'l' AND column_path = '[1]';
----
0

query IIII
SELECT COUNT(*), COUNT(l), SUM(len(l)), SUM(l[3]) FROM t;
----
300000	300000	900000	45000450000

# skipping vectors with zonemaps on another column skips the lists
query II
SELECT COUNT(l), SUM(l[1]) FROM t WHERE id >= 250000;
----
50000	13749975000

query II
SELECT id, l FROM t WHERE id BETWEEN 199998 AND 200001 ORDER BY id;
----
199998	[199998, 199999, 200000]
199999	[199999, 200000, 200001]
200000	[200000, 200001, 200002]
200001	[200001, 200002, 200003]

# fetching rows by row id
query II
SELECT rowid, l FROM t WHERE rowid IN (0, 1, 122879, 122880, 299999) ORDER BY rowid;
----
0	[0, 1, 2]
1	[1, 2, 3]
122879	[122879, 122880, 122881]
122880	[122880, 122881, 122882]
299999	[299999, 300000, 300001]

statement ok
CREATE TABLE idx(id INTEGER PRIMARY KEY, l INTEGER[]);

statement ok
INSERT INTO idx SELECT i, [i, -i] FROM range(10000) t(i);

statement ok
CHECKPOINT;

restart

query I
SELECT COUNT(*) FROM pragma_storage_info('idx') WHERE column_name = 'l' AND column_path = '[1]';
----
0

query I
SELECT l FROM idx WHERE id = 4321;
----
[4321, -4321]

# appending to a row group with implied offsets stores the offsets of the appended lists
statement ok
INSERT INTO idx VALUES (10000, [1, 2, 3]), (10001, NULL), (10002, [4, 5]);

query III
SELECT COUNT(l), SUM(len(l)), SUM(l[1]) FROM idx;
----
10002	20005	49995005

query I
SELECT l FROM idx WHERE id IN (9999, 10000, 10001, 10002) ORDER BY id;
----
[9999, -9999]
[1, 2, 3]
NULL
[4, 5]

# rolled back appends
statement ok
BEGIN;

statement ok
INSERT INTO idx VALUES (10003, [7, 8, 9]);

statement ok
ROLLBACK;

statement error
INSERT INTO idx VALUES (10004, [1]), (1, [2]);
----
<REGEX>:Constraint Error.*

statement ok
CHECKPOINT;

restart

# the lists no longer all have the same length: only the offsets of the appended lists are stored
query I
SELECT SUM(count) FROM pragma_storage_info('idx') WHERE column_name = 'l' AND column_path = '[1]';
----
3

query III
SELECT COUNT(l), SUM(len(l)), SUM(l[1]) FROM idx;
----
10002	20005	49995005

# the rows around the first row with a stored offset, also when scanned in a single vector
query II
SELECT id, l FROM idx WHERE id >= 9998 ORDER BY id;
----
9998	[9998, -9998]
9999	[9999, -9999]
10000	[1, 2, 3]
10001	NULL
10002	[4, 5]

query I
SELECT l FROM idx WHERE id IN (4321, 9999, 10000, 10001, 10002) ORDER BY id;
----
[4321, -4321]
[9999, -9999]
[1, 2, 3]
NULL
[4, 5]

query I
SELECT SUM(l[2]) FROM idx WHERE id > 5000;
----
-37492493

# appending to a row group with implied and stored offsets
statement ok
INSERT INTO idx VALUES (10005, [6, 6]);

query II
SELECT COUNT(l), SUM(l[1]) FROM idx;
----
10003	49995011

statement ok
CHECKPOINT;

restart

query II
SELECT COUNT(l), SUM(l[1]) FROM idx;
----
10003	49995011

# appending lists of the same length to a row group with implied offsets
statement ok
CREATE TABLE same AS SELECT [i, i] AS l FROM range(1000) t(i);

statement ok
CHECKPOINT;

restart

statement ok
INSERT INTO same SELECT [i, i] FROM range(1000, 1500) t(i);

query II
SELECT COUNT(*), SUM(l[2]) FROM same;
----
1500	1124250

statement ok
CHECKPOINT;

restart

query I
SELECT COUNT(*) FROM pragma_storage_info('same') WHERE column_name = 'l' AND column_path = '[0]';
----
0

query II
SELECT COUNT(*), SUM(l[2]) FROM same;
----
1500	1124250

# deleted rows keep their lists
statement ok
DELETE FROM same WHERE l[1] % 2 = 0;

statement ok
CHECKPOINT;

restart

query II
SELECT COUNT(*), SUM(l[2]) FROM same;
----
750	562500

# empty lists
statement ok
CREATE TABLE empty_lists AS SELECT []::INT[] AS l FROM range(5000) t(i);

statement ok
CHECKPOINT;

restart

query I
SELECT COUNT(*) FROM pragma_storage_info('empty_lists') WHERE column_name = 'l' AND column_path = '[0]';
----
0

query II
SELECT COUNT(l), SUM(len(l)) FROM empty_lists;
----
5000	0

# NULL lists or lists of different lengths store their offsets
statement ok
CREATE TABLE with_nulls AS SELECT CASE WHEN i % 3 = 0 THEN NULL ELSE [i, i] END AS l FROM range(5000) t(i);

statement ok
CREATE TABLE mixed AS SELECT range(i % 3) AS l FROM range(5000) t(i);

statement ok
CHECKPOINT;

restart

query II
SELECT COUNT(*) > 0, SUM(count) FROM pragma_storage_info('with_nulls') WHERE column_name = 'l' AND column_path = '[0]';
----
true	5000

query I
SELECT COUNT(*) > 0 FROM pragma_storage_info('mixed') WHERE column_name = 'l' AND column_path = '[0]';
----
true

query III
SELECT COUNT(l), SUM(l[2]), SUM(len(l)) FROM with_nulls;
----
3333	8331667	6666

query II
SELECT COUNT(*), SUM(len(l)) FROM mixed;
----
5000	4999

# lists nested in structs and lists, and maps
statement ok
CREATE TABLE nested AS
SELECT {'a': [i, i], 'b': i} AS s, [[i], [i + 1]] AS ll, MAP([i], [i * 2]) AS m
FROM range(5000) t(i);

statement ok
CHECKPOINT;

restart

query IIII
SELECT SUM(s.a[2]), SUM(ll[2][1]), SUM(m[s.b]), COUNT(*) FROM nested;
----
12497500	12502500	24995000	5000

query III
SELECT s, ll, m FROM nested WHERE s.b = 4242;
----
{'a': [4242, 4242], 'b': 4242}	[[4242], [4243]]	{4242=8484}

# filters on the list column skip the lists that do not pass the filter
statement ok
CREATE TABLE small(g INTEGER[], x VARCHAR[]);

statement ok
INSERT INTO small VALUES ([1, 1, 2], ['a', 'b', 'i']);

statement ok
CHECKPOINT;

restart

query T
SELECT x FROM small WHERE g > [100]
----

query T
SELECT x FROM small WHERE g < [100]
----
[a, b, i]
