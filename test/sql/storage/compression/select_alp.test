# name: test/sql/storage/compression/select_alp.test
# description: Select on ALP segments, including exceptions and NULLs
# group: [compression]

require vector_size 2048

statement ok
ATTACH '{TEST_DIR}/select_alp.db' AS db;

statement ok
SET threads=1;

# regular decimals, large exponents (exceptions) and special values
statement ok
CREATE MACRO expected(i) AS CASE
	WHEN i % 17 = 0 THEN NULL
	WHEN i % 101 = 0 THEN i * 1.2345678901234567e10 + 0.123456789
	WHEN i % 211 = 0 THEN 'nan'::DOUBLE
	ELSE (i % 5000) * 0.37 END;

foreach type DOUBLE FLOAT

statement ok
CREATE TABLE db.t_{type}(id INTEGER, g2 TINYINT, g3 TINYINT, g7 TINYINT, g97 TINYINT, g1000 SMALLINT, v {type} USING COMPRESSION alp);

statement ok
INSERT INTO db.t_{type} SELECT i, hash(i*3)%2, hash(i*5)%3, hash(i*11)%7, hash(i*13)%97, hash(i*17)%1000, expected(i)::{type} FROM range(100000) t(i);

endloop

statement ok
CHECKPOINT db;

foreach type DOUBLE FLOAT

query I
SELECT count(*) > 0 FROM pragma_storage_info('db.t_{type}') WHERE column_name='v' AND compression='ALP';
----
true

foreach col g2 g3 g7 g97 g1000

query I
SELECT count(*) > 0 AND bool_and(v IS NOT DISTINCT FROM expected(id)::{type}) FROM db.t_{type} WHERE {col} = 0;
----
true

endloop

# selections around ALP vector (1024) and standard vector (2048) boundaries
query I
SELECT count(*) = 12 AND bool_and(v IS NOT DISTINCT FROM expected(id)::{type}) FROM db.t_{type} WHERE id IN (0, 1023, 1024, 2047, 2048, 3071, 3072, 50000, 50001, 99998, 99999, 4096);
----
true

# a single selected row in the middle of a vector
query I
SELECT v IS NOT DISTINCT FROM expected(1500)::{type} FROM db.t_{type} WHERE id = 1500;
----
true

endloop
