# name: test/sql/catalog/view/view_ambiguous_catalog_schema.test
# description: Views resolve a qualifier that names both a catalog and a schema of the view's catalog as the schema
# group: [view]

statement ok
ATTACH ':memory:' AS db;

statement ok
ATTACH ':memory:' AS s;

statement ok
CREATE SCHEMA db.db;

statement ok
CREATE SCHEMA db.s;

statement ok
CREATE TABLE db.db.t AS SELECT 1 AS x;

statement ok
CREATE TABLE db.s.u AS SELECT 2 AS y;

# outside of a view the reference stays ambiguous
statement ok
USE db

statement error
SELECT x FROM db.t
----
Ambiguous reference to catalog or schema

statement ok
USE memory

statement ok
CREATE VIEW db.db.v AS SELECT x FROM db.db.t;

statement ok
CREATE VIEW db.main.w AS SELECT y FROM db.s.u;

query I
SELECT x FROM db.db.v
----
1

query I
SELECT y FROM db.main.w
----
2

# view body in a nested subquery
statement ok
CREATE VIEW db.main.w2 AS SELECT * FROM (SELECT y FROM db.s.u) q;

query I
SELECT y FROM db.main.w2
----
2
