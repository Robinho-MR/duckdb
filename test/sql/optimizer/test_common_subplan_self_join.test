# name: test/sql/optimizer/test_common_subplan_self_join.test
# description: Preserve input occurrence identity in common subplans that read the same table more than once
# group: [optimizer]

statement ok
CREATE TABLE self_input(key INTEGER, val INTEGER, s VARCHAR);

statement ok
INSERT INTO self_input VALUES (1, 10, 'a'), (2, 20, 'bb'), (3, 30, 'ccc');

# Reordered aggregate arguments must still refer to the correct join input.
query II rowsort
SELECT sum(lhs.val), sum(rhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key
UNION ALL
SELECT sum(rhs.val), sum(lhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key;
----
40	80
80	40

query II rowsort
SELECT max(lhs.val), min(rhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key
UNION ALL
SELECT max(rhs.val), min(lhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key;
----
20	20
30	10

# Computed projections below the aggregates have the same input identity requirement.
query RR rowsort
SELECT sum(length(lhs.s)), avg(length(lhs.s))
FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key
UNION ALL
SELECT sum(length(rhs.s)), avg(length(rhs.s))
FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key;
----
4	1.3333333333333333
8	2.6666666666666665

# The preserved and null-extended sides of an outer join are different occurrences.
query IIII rowsort
SELECT sum(lhs.val), sum(rhs.val), count(lhs.val), count(rhs.val)
FROM self_input lhs LEFT JOIN self_input rhs ON lhs.key < rhs.key
UNION ALL
SELECT sum(rhs.val), sum(lhs.val), count(rhs.val), count(lhs.val)
FROM self_input lhs LEFT JOIN self_input rhs ON lhs.key < rhs.key;
----
70	80	4	3
80	70	3	4

# Identical expressions may still use exact common-subplan matching.
query II
SELECT sum(lhs.val), sum(rhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key
UNION ALL
SELECT sum(lhs.val), sum(rhs.val) FROM self_input lhs JOIN self_input rhs ON lhs.key < rhs.key;
----
40	80
40	80

# Equal projected inputs also remain distinct occurrences.
statement ok
SET disabled_optimizers='projection_pullup';

query II rowsort
SELECT sum(lhs.v), sum(rhs.v)
FROM (SELECT key, length(s) v FROM self_input) lhs
JOIN (SELECT key, length(s) v FROM self_input) rhs ON lhs.key < rhs.key
UNION ALL
SELECT sum(rhs.v), sum(lhs.v)
FROM (SELECT key, length(s) v FROM self_input) lhs
JOIN (SELECT key, length(s) v FROM self_input) rhs ON lhs.key < rhs.key;
----
4	8
8	4

statement ok
SET disabled_optimizers='';

# Star joins whose duplicate subplans read the same table more than once.
statement ok
CREATE TABLE t(a INTEGER, b INTEGER);

statement ok
INSERT INTO t VALUES (0, 0), (1, 1), (2, 0);

statement ok
CREATE TABLE u(a INTEGER, b INTEGER);

statement ok
INSERT INTO u VALUES (0, 1), (1, 0);

query II
SELECT count(*), sum(x11.a) FROM u x0, u x1, t x2, t x3, u x4, u x5, t x6, u x7, u x8, t x9, u x10, t x11 WHERE x1.a = x0.b AND x2.b = x0.b AND x3.b = x0.b AND x4.a = x0.b AND x5.a = x0.b AND x6.a = x0.b AND x7.b = x0.b AND x8.a = x0.b AND x9.b = x0.b AND x10.b = x0.b AND x11.a = x0.a;
----
9	8

statement ok
SET approximate_join_order_threshold=2

query II
SELECT count(*), sum(x8.a) FROM u x0, t x1, u x2, t x3, u x4, t x5, u x6, t x7, u x8 WHERE x1.b = x0.b AND x2.b = x0.a AND x3.b = x0.b AND x4.a = x0.b AND x5.b = x0.a AND x6.b = x0.b AND x7.a = x0.a AND x8.a = x0.b;
----
6	2

query II
SELECT count(*), sum(x9.a) FROM u x0, u x1, t x2, t x3, t x4, u x5, t x6, u x7, u x8, u x9 WHERE x1.b = x0.a AND x2.a = x0.a AND x3.a = x0.b AND x4.b = x0.b AND x5.a = x0.b AND x6.b = x0.b AND x7.b = x0.b AND x8.b = x0.a AND x9.a = x0.a;
----
5	4
