# name: test/sql/types/union/union_ambiguous.test
# description: Test union types with ambiguous members
# group: [union]

# disallow members with same name (case insensitive)
statement error
CREATE TABLE tbl(a UNION(b INT, b INT));
----
<REGEX>:.*Binder Error.*Duplicate named type parameter.*

statement error
CREATE TABLE tbl(a UNION(b INT, B INT));
----
<REGEX>:.*Binder Error.*Duplicate named type parameter.*

# allow members with same type
statement ok
CREATE TABLE tbl(a UNION(b INT, c INT));

# disallow inserting ambiguous values
statement error
INSERT INTO tbl VALUES (1), (2), (3);
----

# union_value can be used to insert values, but tags are not stored: the member of a value is the first member
# whose type matches the value, so values of the second member are read back as the first member
statement ok
INSERT INTO tbl VALUES (union_value(b := 1)), (union_value(c := 2)), (union_value(b := 3));

# casts between unions match the values against the member types - the member names don't matter
statement ok
INSERT INTO tbl VALUES (union_value(a := 4));

query III
SELECT a, a.b, a.c FROM tbl
----
1	1	NULL
2	2	NULL
3	3	NULL
4	4	NULL

query I
SELECT union_tag(a) FROM tbl
----
b
b
b
b

# the same holds for struct members
statement ok
CREATE TABLE tbl2(a UNION(b STRUCT(foo VARCHAR), c STRUCT(foo VARCHAR)));

statement error
INSERT INTO tbl2 VALUES ({'foo': 'bar'}), ({'foo': 'baz'});
----
<REGEX>:.*The cast is ambiguous.*

statement ok
INSERT INTO tbl2 VALUES (union_value(b := {'foo': 'bar'})), (union_value(c := {'foo': 'baz'})), (union_value(d := {'foo': 'qux'}));

query III
SELECT a, a.b.foo, a.c.foo FROM tbl2
----
{'foo': bar}	bar	NULL
{'foo': baz}	baz	NULL
{'foo': qux}	qux	NULL

# members of different types are distinguished
statement ok
CREATE TABLE tbl3(a UNION(b INT, c STRUCT(b INT)));

statement ok
INSERT INTO tbl3 VALUES (1), (union_value(b := 2)), (union_value(c := {'b': 3}));

query III
SELECT a, union_tag(a), a.c.b FROM tbl3
----
1	b	NULL
2	b	NULL
{'b': 3}	c	3
