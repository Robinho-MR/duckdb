+//! The layout of the manifest columns follows the format-version of the table metadata: if the manifests were written
+//! with another layout, the columns are not of the type we read them as
+static void CheckNestedColumn(const char *name, const Vector &column) {
+	auto type_id = column.GetType().id();
+	if (type_id != LogicalTypeId::LIST && type_id != LogicalTypeId::MAP) {
+		throw InvalidConfigurationException(
+		    "Manifest column '%s' has type %s, expected a list or map - does the format-version of the table metadata "
+		    "match the manifests?",
+		    name, column.GetType().ToString());
+	}
+}
