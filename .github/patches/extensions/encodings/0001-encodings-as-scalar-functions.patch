+static std::mutex &RegisteredLock() {
+	static std::mutex lock;
+	return lock;
+}
+
+static std::unordered_map<string, RegisteredEncoding> &Registered() {
+	static std::unordered_map<string, RegisteredEncoding> registered;
+	return registered;
+}
+
+RegisteredEncoding GetRegisteredEncoding(const string &lowercase_name) {
+	std::lock_guard<std::mutex> guard(RegisteredLock());
+	auto entry = Registered().find(lowercase_name);
+	return entry == Registered().end() ? RegisteredEncoding() : entry->second;
+}
+
+void DBConfig::RegisterEncodeFunction(const EncodingFunction &function) const {
+	auto table = make_shared_ptr<EncodingFunction>(function);
+	duckdb::decode_t decode = [table](const char *input, idx_t input_size, bool is_last, char *output,
+	                                  idx_t &consumed, idx_t &written) {
+		table->decode(*table, input, input_size, is_last, output, consumed, written);
+	};
+	CreateScalarFunctionInfo info(duckdb::EncodingFunction::Create(function.name, decode, function.lookup_bytes,
+	                                                               function.max_output_bytes));
+	duckdb::EncodingFunction::SetSchema(info);
+	loader.RegisterFunction(std::move(info));
+	std::lock_guard<std::mutex> guard(RegisteredLock());
+	Registered()[StringUtil::Lower(function.name)] = {function.max_output_bytes, function.map_size};
 }
 
