+//! Encoding Map Entry Struct used for byte replacement
+typedef struct {
+	size_t key_len;
+	const char *key;
+	size_t value_len;
+	const char *value;
+} map_entry_encoding;
+
+//! A conversion table encoding. This shadows duckdb::EncodingFunction for the generated code, which describes its
+//! encodings with it. Registering one creates the scalar functions in the system.encodings schema.
+class EncodingFunction {
+public:
+	//! Decodes with the conversion table of the encoding, see duckdb::decode_t
+	typedef void (*decode_table_t)(const EncodingFunction &encoding, const char *input, idx_t input_size, bool is_last,
+	                               char *output, idx_t &consumed, idx_t &written);
+
+	EncodingFunction(const string &name, decode_table_t decode, idx_t max_bytes_per_byte, idx_t lookup_bytes,
+	                 const map_entry_encoding *map, idx_t map_size)
+	    : conversion_map(map), map_size(map_size), name(name), decode(decode), max_output_bytes(max_bytes_per_byte),
+	      lookup_bytes(lookup_bytes) {
+	}
+
+	const map_entry_encoding *conversion_map;
+	idx_t map_size;
+	string name;
+	decode_table_t decode;
+	//! The maximum number of UTF-8 bytes produced for one input byte
+	idx_t max_output_bytes;
+	//! The maximum number of input bytes that make up a single character
+	idx_t lookup_bytes;
+};
+
+//! Where the generated code registers its encodings. This shadows duckdb::DBConfig for the generated code.
+class DBConfig {
+public:
+	explicit DBConfig(ExtensionLoader &loader) : loader(loader) {
+	}
+
+	void RegisterEncodeFunction(const EncodingFunction &function) const;
+
+private:
+	ExtensionLoader &loader;
+};
+
+//! What the extension knows about a registered encoding, beyond what its scalar functions say
+struct RegisteredEncoding {
+	idx_t max_output_bytes = 0;
+	idx_t map_size = 0;
+};
+//! The conversion table encoding with the given lowercase name (zeros if there is none)
+RegisteredEncoding GetRegisteredEncoding(const string &lowercase_name);
